{
  "entities": {
    "Participant": {
      "title": "Participant",
      "description": "A registered attendee or participating quartet member",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "password": { "type": "string" },
        "city": { "type": "string" },
        "status": { "type": "string", "enum": ["Pendente", "Presente"] },
        "checkInTime": { "type": "string" },
        "registrationDate": { "type": "string" },
        "registrationType": { "type": "string", "enum": ["Público", "Participante"] },
        "dependents": { "type": "array", "description": "List of children/dependents" }
      },
      "required": ["id", "name", "email", "phone", "status", "registrationDate", "registrationType"]
    },
    "EventConfig": {
      "title": "EventConfig",
      "description": "Global event details and configuration",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "date": { "type": "string" },
        "time": { "type": "string" },
        "location": { "type": "string" },
        "maxParticipants": { "type": "integer" },
        "description": { "type": "string" }
      },
      "required": ["name", "date", "time", "location", "maxParticipants", "description"]
    },
    "StaffUser": {
      "title": "StaffUser",
      "description": "Reception or organizer team user",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "username": { "type": "string" },
        "password": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "username", "password", "createdAt"]
    },
    "WhatsAppTestMessage": {
      "title": "WhatsAppTestMessage",
      "description": "Log of individual WhatsApp test message sent via Meta Cloud API",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "destinationPhone": { "type": "string" },
        "templateName": { "type": "string" },
        "languageCode": { "type": "string" },
        "parameters": { "type": "array" },
        "status": { "type": "string", "enum": ["pending", "sent", "failed", "uncertain"] },
        "wamid": { "type": "string" },
        "errorCode": { "type": "string" },
        "errorMessage": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId", "destinationPhone", "templateName", "languageCode", "status", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/participants/{participantId}": {
      "schema": "Participant",
      "description": "Registered users or groups for the convention"
    },
    "/staffUsers/{staffUserId}": {
      "schema": "StaffUser",
      "description": "Internal administration or reception personnel"
    },
    "/eventConfigs/{configId}": {
      "schema": "EventConfig",
      "description": "Configuration profiles for active events"
    },
    "/whatsappTestMessages/{testId}": {
      "schema": "WhatsAppTestMessage",
      "description": "Records of test messages dispatched via Meta Cloud API"
    }
  }
}
